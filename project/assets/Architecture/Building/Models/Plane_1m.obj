# A 1 x 1 m single-sided quad centred on the origin, facing local +Z. Walls and ceilings in the generated
# interiors are made of these (scaled), so the scene view sees into a room from behind its walls.
o Plane_1m
v -0.5 -0.5 0.0
v 0.5 -0.5 0.0
v 0.5 0.5 0.0
v -0.5 0.5 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 1.0
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
