build/
.vs/
out/
configure_log.txt
*.pdb
Library/

# Auto-save crash-recovery snapshots — regenerated at runtime, never authoritative
*.recovery.json

# Local scratch backups (not authoritative)
*.json.bak

# Per-user editor state (#42): editor_prefs.json / shortcuts.json now resolve under
# %LOCALAPPDATA%\TartarusEngine\ (see src/Core/UserPaths.h), not here — nothing left to ignore
# under project/ for them. A stray copy left by a pre-#42 checkout is still worth ignoring so it
# doesn't get re-added by accident.
project/editor_prefs.json
project/shortcuts.json

# Dock layout (#137): per-user, now under %LOCALAPPDATA%\TartarusEngine\ (UserPaths). A stray
# copy in the working directory is only read once, to migrate an existing layout.
imgui.ini

# Local scratch folder: probe output, logs, re-exported FBX copies. Nothing here is tracked;
# probe and export sources live in tools/probes/ and tools/weapons/ (probe exes build into build/).
work/

# HDRI skies (Poly Haven, CC0) used by the Sandbox scene - too big for git; download into
# project/assets/sky/ (see project/scenes/Sandbox.json skyHdriPath).
project/assets/sky/

# Editor screenshots (#153): captures land in project/screenshots/ so the Asset Browser's
# Screenshots folder can show them, but they're per-user output, not project content. The
# folder itself (and its shutter sound) stays tracked.
project/screenshots/*
!project/screenshots/.shutter.wav
!project/screenshots/.shutter.wav.meta


# Quantum clothing textures (~9 GB) - too big for git, same as the sky HDRIs above. The .meta files stay
# tracked so GUIDs are stable; the PNGs come from the "Quantum Characters" pack (see
# project/assets/Characters/Quantum/_import/IMPORT_NOTES.md for how to restore them).
project/assets/Characters/Quantum/Textures/Clothing/**/*.png

# Hat textures from the Quantum zip: the hats were removed from the project, so the editor
# must not re-create .meta files for local copies of them.
project/assets/Characters/Quantum/Textures/Clothing/Hats/
videos/
