build/
.vs/
out/
configure_log.txt
*.pdb
Library/

# Auto-save crash-recovery snapshots — regenerated at runtime, never authoritative
*.recovery.json

# Local scratch backups (not authoritative)
*.json.bak

# Per-user editor state (#42): editor_prefs.json / shortcuts.json now resolve under
# %LOCALAPPDATA%\TartarusEngine\ (see src/Core/UserPaths.h), not here — nothing left to ignore
# under project/ for them. A stray copy left by a pre-#42 checkout is still worth ignoring so it
# doesn't get re-added by accident.
project/editor_prefs.json
project/shortcuts.json

# Dock layout (#137): per-user, now under %LOCALAPPDATA%\TartarusEngine\ (UserPaths). A stray
# copy in the working directory is only read once, to migrate an existing layout.
imgui.ini
