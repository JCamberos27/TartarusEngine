build/
.vs/
out/
configure_log.txt
*.pdb
Library/

# Auto-save crash-recovery snapshots — regenerated at runtime, never authoritative
*.recovery.json

# Local scratch backups (not authoritative)
*.json.bak

# Per-user editor state (#42): editor_prefs.json / shortcuts.json now resolve under
# %LOCALAPPDATA%\TartarusEngine\ (see src/Core/UserPaths.h), not here — nothing left to ignore
# under project/ for them. A stray copy left by a pre-#42 checkout is still worth ignoring so it
# doesn't get re-added by accident.
project/editor_prefs.json
project/shortcuts.json

# Dock layout (#137): per-user, now under %LOCALAPPDATA%\TartarusEngine\ (UserPaths). A stray
# copy in the working directory is only read once, to migrate an existing layout.
imgui.ini

# Local scratch folder: probe output, logs, re-exported FBX copies. Nothing here is tracked.
work/

# HDRI skies (Poly Haven, CC0) used by the Sandbox scene - too big for git; download into
# project/assets/sky/ (see project/scenes/Sandbox.json skyHdriPath).
project/assets/sky/

# Editor screenshots (#153): captures land in project/screenshots/ so the Asset Browser's
# Screenshots folder can show them, but they're per-user output, not project content. The
# folder itself (and its shutter sound) stays tracked.
project/screenshots/*
!project/screenshots/.shutter.wav
!project/screenshots/.shutter.wav.meta

# Third-party asset payloads: models, textures and audio from licensed packs (Quantum Characters,
# MC Core Motion, Kinemation, Tactical Shooter, Sonniss, KriptoFX, Knife...) may not be redistributed,
# so they are not in git. They live on the team's shared Google Drive ("Tartarus Assets\Used"),
# laid out exactly like this repo; tools/assets/fetch-assets.ps1 copies them in.
# Their .meta files STAY tracked, so GUIDs and every scene/material reference survive, and
# project/external_assets.csv lists each file so the editor never prunes those .meta files as orphans.
project/assets/**/*.[fF][bB][xX]
project/assets/**/*.[pP][nN][gG]
project/assets/**/*.[jJ][pP][gG]
project/assets/**/*.[jJ][pP][eE][gG]
project/assets/**/*.[tT][gG][aA]
project/assets/**/*.[dD][dD][sS]
project/assets/**/*.[eE][xX][rR]
project/assets/**/*.[hH][dD][rR]
project/assets/**/*.[wW][aA][vV]
project/assets/**/*.[oO][gG][gG]
project/assets/**/*.[mM][pP]3
project/assets/**/*.[fF][lL][aA][cC]
project/assets/**/*.[gG][lL][tT][fF]
project/assets/**/*.[gG][lL][bB]
project/assets/**/*.[bB][iI][nN]
project/assets/**/*.[oO][bB][jJ]
project/assets/**/*.[bB][lL][eE][nN][dD]
# ...except content made for this project (procedural / modelled here), which stays in git:
# tools/gen_sandbox_assets.py output (basketball, court, two basketball sounds), the prototype grids,
# the Apartment
# meshes (modelled from measurements; its baked textures are NOT ours to be sure, so they go to Drive),
# the UV-transform test quad, and the generated brow/lash cards.
!project/assets/Props/Basketball/**
!project/assets/Materials/Prototype/**
!project/assets/Audio/basket_score.wav
!project/assets/Audio/basketball_bounce.wav
!project/assets/Environments/Apartment/Models/**
!project/assets/Test/**
!project/assets/Characters/Quantum/Textures/Eyes/T_Brows_Lashes.png
!project/assets/Characters/Quantum/Textures/Eyes/T_F_Brows_Lashes.png

# Hat textures from the Quantum zip: the hats were removed from the project, so the editor
# must not re-create .meta files for local copies of them.
project/assets/Characters/Quantum/Textures/Clothing/Hats/
videos/
# Volumetric blood data converted from the KriptoFX asset (can't be redistributed) - rebuild with
# TartarusEngine --import-blood-fx <package>.
project/assets/Effects/Blood/
project/assets/Effects/Knife/
blood_v2_preview/

# Managed builds and local compiler logs; script sources stay tracked.
**/obj/
**/bin/
project/scripts/*.log
__pycache__/
*.py[cod]
