// GENERATED by CMake from cmake/TartarusVersion.rc.in — do not edit; edit the template instead.
//
// A Windows VERSIONINFO resource, so the shipped exe carries its version where the OS and the
// crash tooling look for it: Explorer > Properties > Details, and the module list inside a
// minidump. Without this a dump names TartarusEngine.exe with version 0.0.0.0 and there is no
// way to tell which build produced the stack.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS      VS_FF_DEBUG
#else
  FILEFLAGS      0x0L
#endif
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0" // US English, Unicode
    BEGIN
      VALUE "CompanyName",      "Jacob Camberos"
      VALUE "FileDescription",  "Tartarus Engine"
      VALUE "FileVersion",      "@PROJECT_VERSION@ (@TARTARUS_GIT_DESCRIBE@)"
      VALUE "InternalName",     "TartarusEngine"
      VALUE "OriginalFilename", "TartarusEngine.exe"
      VALUE "ProductName",      "Tartarus Engine"
      VALUE "ProductVersion",   "@PROJECT_VERSION@ (@TARTARUS_GIT_DESCRIBE@)"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
