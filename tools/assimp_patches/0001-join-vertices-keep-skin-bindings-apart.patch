+// -------------------------------------------------------------------------------------------
+// Vertex identity has to include the skin binding, not just the geometric attributes.
+//
+// Two vertices sitting in exactly the same place but driven by different bones are two
+// *different* vertices: folding one into the other deletes a binding and leaves the
+// surviving vertex as the only representative. That is not hypothetical - the AKS-74U view
+// model ships a second magazine island modelled precisely on top of the installed magazine
+// and driven by its own `mag2` bone, and joining them dropped `mag2` entirely, so the
+// spare magazine never animated.
+//
+// `skin` points into the `vertexBindings` table built up-front in ProcessMesh() and left
+// untouched for the map's whole lifetime, so the pointers stay valid and the key itself
+// stays as cheap to copy as the plain Vertex it replaces.
+// -------------------------------------------------------------------------------------------
+struct SkinnedVertex {
+    Vertex v;
+    const std::pair<unsigned int, ai_real> *skin;
+    unsigned int skinCount;
+};
+
+// Hashes a deliberately coarse quantisation of each weight (1/1024, ~50x looser than the
+// tolerance SameSkin() compares with). Disagreeing on a bucket boundary can only cost a
+// *missed* merge, because equality still has the final say - it can never make two
+// differently skinned vertices look identical.
+inline std::size_t HashSkin(const SkinnedVertex &k) {
+    std::size_t seed = std::hash<Vertex>()(k.v);
+    for (unsigned int i = 0; i < k.skinCount; ++i) {
+        hash_combine(seed, k.skin[i].first,
+                     (std::size_t)std::llround((double)k.skin[i].second * 1024.0));
+    }
+    return seed;
+}
+
+struct SkinnedVertexHash {
+    std::size_t operator()(const SkinnedVertex &k) const noexcept {
+        return HashSkin(k);
+    }
+};
+
+// Same tolerance areVerticesEqual() uses, so the binding is held to the same standard as
+// the rest of the vertex. Bone indices are compared exactly: they are integers, and a
+// mismatch there is precisely the case we must never merge.
+inline bool SameSkin(const SkinnedVertex &a, const SkinnedVertex &b) {
+    if (a.skinCount != b.skinCount) {
+        return false;
+    }
+    static const ai_real skinEpsilon = (ai_real)1e-5;
+    for (unsigned int i = 0; i < a.skinCount; ++i) {
+        if (a.skin[i].first != b.skin[i].first) {
+            return false;
+        }
+        if (std::fabs(a.skin[i].second - b.skin[i].second) > skinEpsilon) {
+            return false;
+        }
+    }
+    return true;
+}
+
+struct SkinnedVertexEqual {
+    SkinnedVertexEqual(unsigned numUVChannels, unsigned numColorChannels) :
+            mNumUVChannels(numUVChannels),
+            mNumColorChannels(numColorChannels) {}
+
+    bool operator()(const SkinnedVertex &lhs, const SkinnedVertex &rhs) const {
+        return SameSkin(lhs, rhs) &&
+               areVerticesEqual(lhs.v, rhs.v, mNumUVChannels, mNumColorChannels);
+    }
+
+private:
+    unsigned mNumUVChannels;
+    unsigned mNumColorChannels;
+};
+
